# ---------------------------------------------------------------------------
# App runtime (.env.local). All five are required for the site to boot.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Public by design — ships to browsers. Safe only because RLS refuses
# everything except approved places and the area list.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS. Server-side only; never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=
# The single address allowed into /admin. Everything else is refused.
ADMIN_EMAIL=
# Canonical origin — drives metadataBase, canonical/OG tags, robots.txt and
# sitemap.xml. OPTIONAL ON VERCEL: leave it blank and the app uses Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL, which is always the real domain. Set it only
# for a custom domain, and set it to the actual origin — obvious placeholders
# (CHANGE-ME, your-domain, example.com) are rejected and treated as blank,
# because shipping one publishes a sitemap of dead URLs without any visible
# symptom. Locally, blank means http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Tooling only (.env.db.local — kept out of .env.local so Next.js can never
# read these at runtime). Needed for migrations and seeding, not for the app.
# ---------------------------------------------------------------------------
# Supabase personal access token (sbp_…), from
# https://supabase.com/dashboard/account/tokens
# Lets `db:push` and `rls:test:live` reach the database over HTTPS. Required
# anywhere outbound port 5432 is blocked — which includes Claude Code sandboxes
# and most CI runners.
# SUPABASE_ACCESS_TOKEN=
#
# Direct Postgres URL. Only usable where raw TCP on 5432 is open. Leave unset
# otherwise: the seed scripts prefer it when present and will fail on it.
# SUPABASE_DB_URL=
